PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/investmentwebsite?retryWrites=true&w=majority

CLIENT_URL=http://localhost:5173

LOOKBACK_DAYS=7
MIN_PERCENT_GAIN=0

# Set true if NSE/BSE or MongoDB fail with "self-signed certificate in certificate chain"
ALLOW_INSECURE_SSL=false

# Comma-separated symbols to dump full API data in server logs (e.g. INDOBORAX)
DEBUG_SYMBOLS=
