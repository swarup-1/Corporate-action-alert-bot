# Copy to .env and edit. Local runs load .env automatically (python-dotenv).
# On GitHub: use Secrets for token/chat_id, Variables for the rest (see README).

# --- Required ---
TELEGRAM_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# --- Alert rules ---
MIN_PERCENT_GAIN=0.2
LOOKBACK_DAYS=1
ALERT_DIVIDENDS=true
ALERT_OTHER_CA=true

# --- Local only (GitHub uses workflow cron every 30 min) ---
POLL_MINUTES=30
